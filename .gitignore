node_modules/
test-results/
playwright-report/
.env
dbt_internal_packages/

# Internal financial source-of-truth files and dbt logs — never commit (public repo)
sources/
logs/

# Account-level snapshots (contain Company names + per-customer MRR) — never commit (public repo)
scripts/audit/*.json
.superpowers/

# MCP deploy bundle — pure generated copies (dbt manifest + model SQL), created
# by `npm run prepare-deploy` in mcp/metrics/ at deploy time
mcp/metrics/bundle/
mcp/metrics/.vercel/

# MWD board-prep query outputs (may contain MRR/customer-level data) — never commit (public repo)
scripts/mwd-board-prep/out/

# Python bytecode caches
__pycache__/
*.py[cod]

# dbt artifacts. Only the two things the builds actually read stay tracked:
#   target/manifest.json                                  -> scripts/build_dbt_models_json.mjs (builder prebuild, runs in CI)
#   target/compiled/method_metrics/models/**/*.sql        -> mcp/metrics/scripts/prepare-deploy.mjs
# Everything else (run/, run_results.json, generic_tests/, *.macro_spans.json)
# is regenerated by every dbt invocation and only served to keep the working
# tree permanently dirty.
target/*
!target/compiled
!target/manifest.json
target/compiled/*
!target/compiled/method_metrics
target/compiled/method_metrics/*
!target/compiled/method_metrics/models
target/compiled/method_metrics/models/**/*.macro_spans.json

# Any script's query output. Individual dirs were enumerated one at a time and
# the list kept falling behind (scripts/speed-to-lead/out was never covered).
# These hold account names and MRR — pattern beats enumeration on a public repo.
scripts/*/out/

# Pickled analysis caches. buckets.pkl held verbatim customer TimeTracking
# notes, names included, at the repo root.
*.pkl
