# Offline UI-dev config. Loaded only by `npm run dev:mock` (vite --mode mock).
#
# Committed on purpose: it enables fixtures, and every consumer of these vars is
# additionally gated on `import.meta.env.DEV`, so `vite build` cannot ship mock
# data even if this file is present.
VITE_MOCK_DATA=true

# Which consultant the mock app is "signed in" as. Drives the /ps and /call-prep
# scoping via consultantPatternFromEmail(), so it must have a first.last shape.
VITE_MOCK_EMAIL=b.saltzman@method.me

# true  = fully offline (Supabase reads come from fixtures too)
# false = keep the real Supabase catalog/dashboards (needs network, no auth
#         required) while BigQuery/PS data stays faked
VITE_MOCK_SUPABASE=true

# Fake per-query latency in ms, so loading states are visible. 0 = instant.
VITE_MOCK_LATENCY=140
